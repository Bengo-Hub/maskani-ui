# Public values are baked in at build time (Dockerfile build args). Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SSO_URL=https://sso.codevertexafrica.com
NEXT_PUBLIC_SSO_CLIENT_ID=maskani-ui
NEXT_PUBLIC_AUTH_UI_URL=https://accounts.codevertexafrica.com
NEXT_PUBLIC_TREASURY_API_URL=https://booksapi.codevertexafrica.com
NEXT_PUBLIC_TREASURY_UI_URL=https://books.codevertexafrica.com
NEXT_PUBLIC_NOTIFICATIONS_URL=https://notificationsapi.codevertexafrica.com
NEXT_PUBLIC_SUBSCRIPTIONS_UI_URL=https://pricing.codevertexafrica.com

# Server-only (subscription proxy route). In the cluster these come from values.yaml and
# the maskani-ui-secrets secret.
SUBSCRIPTION_BASE_URL=https://subscriptionsapi.codevertexafrica.com
INTERNAL_SERVICE_KEY=YOUR_INTERNAL_SERVICE_KEY_HERE

# Windows local builds
SKIP_STANDALONE=true
